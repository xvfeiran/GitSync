<Window x:Class="VendorSync.UI.CloneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VendorSync.UI"
        Title="{loc:LocExt Title.Clone}" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="20,16">
        <TextBlock Text="{loc:LocExt Clone.Intro}" TextWrapping="Wrap"
                   Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,14"/>

        <TextBlock Text="{loc:LocExt Clone.SourceLabel}" Margin="0,0,0,4"/>
        <TextBox x:Name="SourceBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Text="{loc:LocExt Clone.TargetLabel}" Margin="0,0,0,4"/>
        <TextBox x:Name="TargetBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Text="{loc:LocExt Clone.DestLabel}" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,16">
            <Button x:Name="BtnBrowse" Content="{loc:LocExt Btn.Browse}" Width="80" Height="32" Margin="8,0,0,0"
                    DockPanel.Dock="Right" Click="BtnBrowse_Click"/>
            <TextBox x:Name="DestBox" Height="32" VerticalContentAlignment="Center"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:LocExt Btn.Cancel}" Width="90" Height="34" IsCancel="True" Style="{StaticResource BaseButton}"/>
            <Button x:Name="BtnOk" Content="{loc:LocExt Btn.Clone}" Width="90" Height="34" Margin="8,0,0,0" Click="BtnOk_Click"
                    Style="{StaticResource PrimaryButton}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="VendorSync.UI.CloneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="克隆仓库" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="20,16">
        <TextBlock Text="从源仓库克隆一份到本地；需要同步到另一个仓库的话，再填一行目标仓库地址。" TextWrapping="Wrap"
                   Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,14"/>

        <TextBlock Text="源仓库地址（upstream）" Margin="0,0,0,4"/>
        <TextBox x:Name="SourceBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Text="目标仓库地址（可选，留空则只克隆）" Margin="0,0,0,4"/>
        <TextBox x:Name="TargetBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Text="克隆到目录（需要是空目录）" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,16">
            <Button x:Name="BtnBrowse" Content="浏览…" Width="80" Height="32" Margin="8,0,0,0"
                    DockPanel.Dock="Right" Click="BtnBrowse_Click"/>
            <TextBox x:Name="DestBox" Height="32" VerticalContentAlignment="Center"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" Height="34" IsCancel="True" Style="{StaticResource BaseButton}"/>
            <Button x:Name="BtnOk" Content="克隆" Width="90" Height="34" Margin="8,0,0,0" Click="BtnOk_Click"
                    Style="{StaticResource PrimaryButton}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>

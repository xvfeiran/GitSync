<Window x:Class="VendorSync.UI.RemoteSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程仓库设置" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="20,16">
        <TextBlock Text="设置这个项目同步用的两个远程仓库：名字与地址。地址不存在时会自动挂上（git remote add），改了地址会自动更新（git remote set-url）。"
                   TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,14"/>

        <TextBlock Text="源仓库远程名" Margin="0,0,0,4"/>
        <ComboBox x:Name="VendorBox" IsEditable="True" Height="32" Margin="0,0,0,6"
                  VerticalContentAlignment="Center" SelectionChanged="VendorBox_SelectionChanged"/>
        <TextBlock Text="源仓库地址（HTTPS 或 SSH）" Margin="0,0,0,4"/>
        <TextBox x:Name="VendorUrlBox" Height="32" Margin="0,0,0,12"
                 VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12.5"/>

        <TextBlock Text="目标仓库远程名" Margin="0,0,0,4"/>
        <ComboBox x:Name="InternalBox" IsEditable="True" Height="32" Margin="0,0,0,6"
                  VerticalContentAlignment="Center" SelectionChanged="InternalBox_SelectionChanged"/>
        <TextBlock Text="目标仓库地址（HTTPS 或 SSH）" Margin="0,0,0,4"/>
        <TextBox x:Name="InternalUrlBox" Height="32" Margin="0,0,0,16"
                 VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12.5"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" Height="34" IsCancel="True" Style="{StaticResource BaseButton}"/>
            <Button Content="保存" Width="90" Height="34" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

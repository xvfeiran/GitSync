<Window x:Class="VendorSync.UI.RemoteSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VendorSync.UI"
        Title="{loc:LocExt Title.RemoteSettings}" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="20,16">
        <TextBlock Text="{loc:LocExt Remote.Intro}"
                   TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,14"/>

        <TextBlock Text="{loc:LocExt Remote.VendorName}" Margin="0,0,0,4"/>
        <ComboBox x:Name="VendorBox" IsEditable="True" Height="32" Margin="0,0,0,6"
                  VerticalContentAlignment="Center" SelectionChanged="VendorBox_SelectionChanged"/>
        <TextBlock Text="{loc:LocExt Remote.VendorUrl}" Margin="0,0,0,4"/>
        <TextBox x:Name="VendorUrlBox" Height="32" Margin="0,0,0,12"
                 VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12.5"/>

        <TextBlock Text="{loc:LocExt Remote.InternalName}" Margin="0,0,0,4"/>
        <ComboBox x:Name="InternalBox" IsEditable="True" Height="32" Margin="0,0,0,6"
                  VerticalContentAlignment="Center" SelectionChanged="InternalBox_SelectionChanged"/>
        <TextBlock Text="{loc:LocExt Remote.InternalUrl}" Margin="0,0,0,4"/>
        <TextBox x:Name="InternalUrlBox" Height="32" Margin="0,0,0,16"
                 VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12.5"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:LocExt Btn.Cancel}" Width="90" Height="34" IsCancel="True" Style="{StaticResource BaseButton}"/>
            <Button Content="{loc:LocExt Btn.Save}" Width="90" Height="34" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

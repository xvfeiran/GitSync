<Window x:Class="VendorSync.UI.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VendorSync.UI"
        Title="{loc:LocExt Title.Credentials}" Width="820" Height="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F5F8FA" Padding="16,10" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{loc:LocExt Title.Credentials}" FontSize="16" FontWeight="Bold"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0"
                           Text="{loc:LocExt Cred.Intro}"/>
            </StackPanel>
        </Border>

        <TabControl Margin="16">
            <TabItem Header="{loc:LocExt Tab.Ssh}">
                <StackPanel Margin="8,12">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                               Text="{loc:LocExt Cred.SshIntro}"/>

                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                        <TextBlock x:Name="SshStatus" FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock Text="{loc:LocExt Cred.ExistingKeys}" Margin="0,12,0,4"/>
                    <ListBox x:Name="KeyList" Height="110" BorderBrush="{StaticResource InputBorderBrush}"
                             SelectionChanged="KeyList_SelectionChanged" DisplayMemberPath="Display"/>

                    <DockPanel Margin="0,12,0,0">
                        <Button x:Name="BtnGenerate" Content="{loc:LocExt Btn.GenKey}" Height="32" Padding="12,0"
                                DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Click="GenerateKey_Click"/>
                        <Button x:Name="BtnTest" Content="{loc:LocExt Btn.TestSsh}" Height="32" Padding="12,0"
                                DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource BaseButton}" Click="TestSsh_Click"/>
                        <TextBlock Text="{loc:LocExt Cred.CommentLabel}" VerticalAlignment="Center"/>
                        <TextBox x:Name="KeyComment" Height="30" VerticalContentAlignment="Center" Width="240"
                                 HorizontalAlignment="Left" Margin="4,0,0,0"/>
                    </DockPanel>

                    <TextBlock Text="{loc:LocExt Cred.PublicKeyLabel}" Margin="0,12,0,4"/>
                    <TextBox x:Name="PublicKey" Height="60" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             BorderBrush="{StaticResource InputBorderBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{loc:LocExt Btn.CopyPub}" Height="30" Padding="12,0" Style="{StaticResource BaseButton}"
                                Click="CopyPublic_Click"/>
                        <Button Content="{loc:LocExt Btn.OpenRegister}" Height="30" Padding="12,0" Margin="8,0,0,0"
                                Style="{StaticResource BaseButton}" Click="OpenRegisterPage_Click"/>
                    </StackPanel>

                    <TextBox x:Name="SshResult" Height="90" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             Background="#FAFAFA" BorderBrush="{StaticResource InputBorderBrush}"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="{loc:LocExt Tab.Https}">
                <StackPanel Margin="8,12">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                               Text="{loc:LocExt Cred.HttpsIntro}"/>

                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                        <TextBlock x:Name="HttpsStatus" FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:LocExt Detail.Recheck}" Height="32" Padding="12,0" Style="{StaticResource BaseButton}"
                                Click="HttpsCheck_Click"/>
                        <Button x:Name="BtnRepair" Content="{loc:LocExt Btn.RepairGit}" Height="32" Padding="12,0" Margin="8,0,0,0"
                                Style="{StaticResource BaseButton}" Visibility="Collapsed" Click="RepairHelper_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="HttpsHint" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

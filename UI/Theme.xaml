<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:VendorSync.UI.Controls">

    <!-- ============ 新拟态 v2 调色板 ============ -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#E3E9F1"/>
    <SolidColorBrush x:Key="FaceBrush" Color="#E9EDF4"/>
    <SolidColorBrush x:Key="FaceDarkBrush" Color="#D8DEE8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#003E92"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#DCE9F8"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B6FC4" Offset="0"/>
        <GradientStop Color="#0057AE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBgBrush" Color="#E9EDF4"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#D3DAE4"/>
    <SolidColorBrush x:Key="InnerBorderBrush" Color="#D3DAE4"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F2733"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#5D6B7E"/>
    <SolidColorBrush x:Key="OkBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="OkBgBrush" Color="#DFF2DF"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#9A6200"/>
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FFF1CE"/>
    <SolidColorBrush x:Key="PendingBrush" Color="#E88A1A"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="ErrorBgBrush" Color="#F9DEDA"/>
    <SolidColorBrush x:Key="LogBgBrush" Color="#1B222E"/>
    <SolidColorBrush x:Key="LogFgBrush" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#E4E9F0"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C9D2DE"/>

    <!-- 状态色（分支表等） -->
    <SolidColorBrush x:Key="StateBehindFg" Color="#003E92"/>
    <SolidColorBrush x:Key="StateBehindBg" Color="#DCE9F8"/>
    <SolidColorBrush x:Key="StateNewFg" Color="#00575C"/>
    <SolidColorBrush x:Key="StateNewBg" Color="#DCF2F0"/>
    <SolidColorBrush x:Key="StateDivergedFg" Color="#7A4800"/>
    <SolidColorBrush x:Key="StateDivergedBg" Color="#FFF1CE"/>
    <SolidColorBrush x:Key="StateTargetAheadFg" Color="#4B3596"/>
    <SolidColorBrush x:Key="StateTargetAheadBg" Color="#EBE5F8"/>
    <SolidColorBrush x:Key="StateGoneFg" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="StateGoneBg" Color="#ECEFF3"/>

    <!-- ============ 新拟态面板 ============ -->
    <Style TargetType="local:Neu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Neu">
                    <Grid>
                        <Border x:Name="PART_Dark" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border x:Name="PART_Light" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Grid x:Name="PART_InsetHost" Background="Transparent">
                            <Border x:Name="PART_InsetDark" Background="Transparent"/>
                            <Border x:Name="PART_InsetLight" Background="Transparent"/>
                        </Grid>
                        <Border x:Name="PART_Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <!-- ============ 状态核 ============ -->
    <Style TargetType="local:StatusOrb">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:StatusOrb">
                    <Grid>
                        <!-- 凹槽 -->
                        <Ellipse Fill="{StaticResource FaceDarkBrush}"/>
                        <Ellipse Stroke="#C3CCD9" StrokeThickness="1"/>
                        <!-- 状态圆 -->
                        <Ellipse x:Name="Core" Margin="7" Fill="{StaticResource AccentBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#005FB8" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- 旋转外圈（进行中） -->
                        <local:RingArc x:Name="Spin" Margin="3" Thickness="2.5"
                                       Stroke="{StaticResource AccentBrush}" Progress="0.25"
                                       Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <local:RingArc.RenderTransform>
                                <RotateTransform x:Name="SpinRotate"/>
                            </local:RingArc.RenderTransform>
                        </local:RingArc>
                        <TextBlock x:Name="Num" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="14" Foreground="White" Text="{TemplateBinding Text}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Unknown">
                            <Setter TargetName="Core" Property="Fill" Value="#B7C1CF"/>
                            <Setter TargetName="Core" Property="Effect">
                                <Setter.Value><DropShadowEffect BlurRadius="0" ShadowDepth="0"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="Num" Property="Foreground" Value="#6B7686"/>
                        </Trigger>
                        <Trigger Property="State" Value="UpToDate">
                            <Setter TargetName="Core" Property="Fill" Value="{StaticResource OkBrush}"/>
                            <Setter TargetName="Core" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="#0F7B0F" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="State" Value="Pending">
                            <Setter TargetName="Core" Property="Fill" Value="{StaticResource PendingBrush}"/>
                            <Setter TargetName="Core" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="#E88A1A" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="State" Value="Failed">
                            <Setter TargetName="Core" Property="Fill" Value="{StaticResource ErrorBrush}"/>
                            <Setter TargetName="Core" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="#C0392B" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 按钮 ============ -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{StaticResource FaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="{TemplateBinding Padding}" BorderBrush="#D0D8E2" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="{x:Static local:Neu.ShadowColor}" Direction="315"
                                              BlurRadius="9" ShadowDepth="3" Opacity="0.4"
                                              RenderingBias="Performance"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#EFF3F9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#DDE4EC"/>
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{x:Static local:Neu.ShadowColor}" Direction="135"
                                                      BlurRadius="7" ShadowDepth="1" Opacity="0.35"
                                                      RenderingBias="Performance"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#005FB8" BlurRadius="14" ShadowDepth="4" Opacity="0.45"
                                              RenderingBias="Performance"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 输入框 / 下拉 -->
    <Style x:Key="Input" TargetType="Control">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- 圆片过滤按钮 -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" CornerRadius="14" BorderThickness="1"
                            Background="{StaticResource FaceBrush}" BorderBrush="#C9D2DE" Padding="12,2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 下拉框（与整体新拟态风格统一） ============ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="4,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="{x:Static local:Neu.ShadowColor}" Direction="315"
                                                  BlurRadius="8" ShadowDepth="2" Opacity="0.35"
                                                  RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <!-- 非编辑态显示当前选择 -->
                            <ContentPresenter x:Name="SelectedContent" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <!-- 编辑态输入框 -->
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Visibility="Hidden"
                                     Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}"
                                     VerticalAlignment="Center" Padding="0" CaretBrush="{StaticResource TextBrush}"/>
                            <!-- 箭头 -->
                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="#5D6B7E" StrokeThickness="1.6"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{StaticResource FaceBrush}" CornerRadius="10" BorderBrush="#C9D2DE"
                                    BorderThickness="1" Margin="0,4,0,8" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{x:Static local:Neu.ShadowColor}" Direction="315"
                                                      BlurRadius="14" ShadowDepth="4" Opacity="0.45"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,6" Margin="2">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#EFF3F9"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="SelectedContent" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Toggle" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Toggle" Property="Width" Value="24"/>
                            <Setter Property="Cursor" Value="IBeam"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#F2F6FB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日志区按钮 -->
    <Style x:Key="LogButton" TargetType="Button">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#C8C8C8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

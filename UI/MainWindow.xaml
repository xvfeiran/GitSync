<Window x:Class="VendorSync.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:VendorSync.UI.Controls"
        xmlns:loc="clr-namespace:VendorSync.UI"
        Title="{loc:LocExt App.Title}" Height="800" Width="1180" MinHeight="640" MinWidth="960"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <!-- 项目卡片 -->
        <DataTemplate x:Key="ProjectCard">
            <Button Click="Card_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:LocExt Menu.OpenFolder}" Click="MenuOpenFolder_Click"/>
                        <MenuItem Header="{loc:LocExt Menu.Remotes}" Click="MenuRemotes_Click"/>
                        <MenuItem Header="{loc:LocExt Menu.Remove}" Click="MenuRemove_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Border Margin="0,0,0,4">
                    <ctrl:Neu CornerRadius="18" Padding="18,16" Margin="6">
                        <StackPanel>
                            <DockPanel>
                                <ctrl:StatusOrb DockPanel.Dock="Right" State="{Binding Orb}" Text="{Binding PendingText}"/>
                                <TextBlock Text="{Binding Model.DisplayName}" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="0,8,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding RoutesText}"/>
                            <TextBlock Text="{Binding Message}" FontSize="12.5" Margin="0,10,0,0"
                                       TextWrapping="Wrap" MaxHeight="36" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding LastRunText}" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </ctrl:Neu>
                </Border>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 日志抽屉 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource LogBgBrush}" Padding="16,4,16,8">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{loc:LocExt Log.CopyAll}" Click="BtnCopyLog_Click" Style="{StaticResource LogButton}"/>
                        <Button Content="{loc:LocExt Log.CopyDiag}" Click="BtnCopyDiag_Click" Style="{StaticResource LogButton}"/>
                        <Button Content="{loc:LocExt Log.Clear}" Click="BtnClearLog_Click" Style="{StaticResource LogButton}"/>
                        <Button x:Name="BtnLogToggle" Content="{loc:LocExt Log.Expand}" Click="BtnLogToggle_Click" Style="{StaticResource LogButton}"/>
                    </StackPanel>
                    <TextBlock x:Name="LogOneLine" Text="{loc:LocExt Log.Title}" Foreground="#9AA4B2" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBox x:Name="LogBox" Background="Transparent" Foreground="{StaticResource LogFgBrush}"
                         BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Padding="0,6,0,2" Height="230"
                         Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource WindowBgBrush}" Padding="20,4">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="{loc:LocExt Status.Starting}" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="EnvText" Text="" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock x:Name="AppInfoText" Text="" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 首页：卡片墙 ============ -->
        <Grid x:Name="HomeView" Margin="24,10,24,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnLang" Content="{loc:LocExt Lang.SwitchTarget}" Click="BtnLang_Click"
                                    Style="{StaticResource BaseButton}"/>
                            <Button Content="{loc:LocExt Btn.Credentials}" Click="BtnCredentials_Click" Margin="8,0,0,0"
                                    Style="{StaticResource BaseButton}"/>
                            <Button x:Name="BtnAdd" Content="{loc:LocExt Btn.Add}" Click="BtnAdd_Click" Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:LocExt Home.Title}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock x:Name="HomeSummary" Text="" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock x:Name="EmptyHint" Text="{loc:LocExt Home.Empty}"
                               Foreground="{StaticResource SubTextBrush}" FontSize="14" Margin="0,40,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <ItemsControl x:Name="CardList" ItemsSource="{Binding}" ItemTemplate="{StaticResource ProjectCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ 详情页 ============ -->
        <Grid x:Name="DetailView" Margin="24,10,24,6" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{loc:LocExt Btn.Credentials}" Click="BtnCredentials_Click"
                                Style="{StaticResource BaseButton}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Left" Content="{loc:LocExt Detail.Back}" Click="BtnBack_Click"
                                Style="{StaticResource BaseButton}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="DetailTitle" Text="" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- 源 → 目标 凹槽 -->
                    <DockPanel Margin="0,14,0,0">
                        <ctrl:Neu DockPanel.Dock="Right" Depth="Inset" CornerRadius="10" Padding="12,8" Width="360">
                            <StackPanel>
                                <TextBlock Text="{loc:LocExt Detail.Target}" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock x:Name="DetailTarget" Text="—" FontFamily="Consolas" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ctrl:Neu>
                        <TextBlock DockPanel.Dock="Right" Text="→" FontSize="20" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="12,0,12,0"/>
                        <ctrl:Neu Depth="Inset" CornerRadius="10" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="{loc:LocExt Detail.Source}" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock x:Name="DetailSource" Text="—" FontFamily="Consolas" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            </StackPanel>
                        </ctrl:Neu>
                    </DockPanel>

                    <!-- 四步进度 + 说明 + 旋钮 -->
                    <DockPanel Margin="0,14,0,0">
                        <Grid DockPanel.Dock="Right" Width="170" Height="170" Margin="10,0,0,0">
                            <ctrl:Neu Depth="Raised" CornerRadius="85"/>
                            <ctrl:RingArc x:Name="DetailRing" Margin="12" Thickness="6"
                                          Stroke="{StaticResource AccentBrush}" TrackBrush="#C9D2DE" Progress="0"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="DetailPercent" Text="" HorizontalAlignment="Center"
                                           FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="DetailKnobText" Text="{loc:LocExt Detail.Sync}" HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource SubTextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" x:Name="DetailSteps">
                                <TextBlock x:Name="StepConn" Text="{loc:LocExt Step.Conn}" FontSize="12" Foreground="#8A94A6"/>
                                <TextBlock Text="  —  " Foreground="#C0C8D4" FontSize="12"/>
                                <TextBlock x:Name="StepCheck" Text="{loc:LocExt Step.Check}" FontSize="12" Foreground="#8A94A6"/>
                                <TextBlock Text="  —  " Foreground="#C0C8D4" FontSize="12"/>
                                <TextBlock x:Name="StepPush" Text="{loc:LocExt Step.Push}" FontSize="12" Foreground="#8A94A6"/>
                                <TextBlock Text="  —  " Foreground="#C0C8D4" FontSize="12"/>
                                <TextBlock x:Name="StepVerify" Text="{loc:LocExt Step.Verify}" FontSize="12" Foreground="#8A94A6"/>
                            </StackPanel>
                            <TextBlock x:Name="DetailSummary" Text="" TextWrapping="Wrap" FontSize="13.5" Margin="0,10,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ComboBox x:Name="DetailStrategy" Height="30" Width="230" VerticalContentAlignment="Center"
                                          SelectionChanged="DetailStrategy_Changed">
                                    <ComboBoxItem Content="{loc:LocExt Strategy.Force}"/>
                                    <ComboBoxItem Content="{loc:LocExt Strategy.Merge}"/>
                                </ComboBox>
                                <CheckBox x:Name="DetailTags" Content="{loc:LocExt Detail.IncludeTags}" VerticalContentAlignment="Center"
                                          Margin="14,0,0,0" Checked="DetailTags_Changed" Unchecked="DetailTags_Changed"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnDetailSync" Content="{loc:LocExt Detail.Sync}" Style="{StaticResource PrimaryButton}"
                                        Click="BtnDetailSync_Click"/>
                                <Button x:Name="BtnDetailCheck" Content="{loc:LocExt Detail.Recheck}" Style="{StaticResource BaseButton}"
                                        Click="BtnDetailCheck_Click" Margin="10,0,0,0"/>
                                <Button x:Name="BtnDetailRemotes" Content="{loc:LocExt Detail.Remotes}" Style="{StaticResource BaseButton}"
                                        Click="BtnDetailRemotes_Click" Margin="10,0,0,0"
                                        ToolTip="{loc:LocExt Detail.RemotesTip}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- 分支列表 -->
                    <ctrl:Neu Depth="Inset" CornerRadius="12" Padding="4,8" Margin="0,16,0,0">
                        <StackPanel>
                            <DockPanel Margin="10,0">
                                <ToggleButton x:Name="BranchToggle" Content="{loc:LocExt Branch.OnlyPending}" IsChecked="False" Style="{StaticResource Chip}"
                                              Click="BranchToggle_Click" ToolTip="{loc:LocExt Branch.OnlyPendingTip}"/>
                                <TextBlock x:Name="BranchSummary" Text="" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource SubTextBrush}"/>
                            </DockPanel>
                            <ItemsControl x:Name="BranchList" Margin="10,8,10,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,5" CornerRadius="6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Result}" FontSize="12"
                                                           Foreground="{StaticResource SubTextBrush}" Margin="12,0,0,0"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Delta}" FontSize="12"
                                                           Foreground="{StaticResource SubTextBrush}" Margin="12,0,0,0"
                                                           MinWidth="110"/>
                                                <Border Background="{Binding StateBg}" CornerRadius="4" Padding="7,2"
                                                        DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateLabel}" FontSize="11.5" Foreground="{Binding StateFg}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12.5"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ctrl:Neu>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="VendorSync.UI.CredentialPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="需要登录凭据" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="20,16">
        <TextBlock x:Name="HeaderText" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <TextBlock x:Name="HostText" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                   Margin="0,6,0,14"/>

        <TextBlock Text="用户名 / 域账号" Margin="0,0,0,4"/>
        <TextBox x:Name="UserBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

        <DockPanel Margin="0,0,0,4">
            <CheckBox x:Name="ShowToggle" Content="显示" DockPanel.Dock="Right" VerticalAlignment="Center"
                      Checked="ShowToggle_Changed" Unchecked="ShowToggle_Changed"/>
            <TextBlock Text="密码 / 个人访问令牌（PAT）"/>
        </DockPanel>
        <PasswordBox x:Name="PassBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
        <TextBox x:Name="PlainBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"
                 Visibility="Collapsed"/>

        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                   Text="输入会通过 git credential 协议交给 Windows 凭据管理器加密保存；本工具不落盘、不保存密码。之后所有 git 操作自动取用，不再询问。"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="90" Height="34" IsCancel="True" Style="{StaticResource BaseButton}"/>
            <Button Content="保存并继续" Width="120" Height="34" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

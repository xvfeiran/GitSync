<Window x:Class="VendorSync.UI.CredentialPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VendorSync.UI"
        Title="{loc:LocExt Title.CredPrompt}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="20,16">
        <TextBlock x:Name="HeaderText" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <TextBlock x:Name="HostText" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                   Margin="0,6,0,14"/>

        <TextBlock Text="{loc:LocExt CredPrompt.UserLabel}" Margin="0,0,0,4"/>
        <TextBox x:Name="UserBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

        <DockPanel Margin="0,0,0,4">
            <CheckBox x:Name="ShowToggle" Content="{loc:LocExt CredPrompt.Show}" DockPanel.Dock="Right" VerticalAlignment="Center"
                      Checked="ShowToggle_Changed" Unchecked="ShowToggle_Changed"/>
            <TextBlock Text="{loc:LocExt CredPrompt.PassLabel}"/>
        </DockPanel>
        <PasswordBox x:Name="PassBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
        <TextBox x:Name="PlainBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"
                 Visibility="Collapsed"/>

        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                   Text="{loc:LocExt CredPrompt.Note}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:LocExt Btn.Cancel}" Width="90" Height="34" IsCancel="True" Style="{StaticResource BaseButton}"/>
            <Button Content="{loc:LocExt Btn.SaveContinue}" Width="120" Height="34" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="VendorSync.UI.AddProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加同步项目" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="20,16">
        <TextBlock Text="一个项目 = 一个本地仓库 + 它的源仓库远程 + 目标仓库远程。已有本地克隆就选目录；还没有就先克隆。"
                   TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,14"/>

        <DockPanel Margin="0,0,0,12">
            <Button Content="克隆新仓库…" Width="110" Height="32" DockPanel.Dock="Right" Margin="8,0,0,0"
                    Style="{StaticResource BaseButton}" Click="BtnClone_Click"/>
            <Button Content="浏览…" Width="80" Height="32" DockPanel.Dock="Right" Margin="8,0,0,0"
                    Style="{StaticResource BaseButton}" Click="BtnBrowse_Click"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="本地仓库目录" VerticalAlignment="Center"/>
                <TextBox x:Name="PathBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
            </Grid>
        </DockPanel>

        <DockPanel Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="源仓库远程" VerticalAlignment="Center"/>
                <ComboBox x:Name="VendorBox" Grid.Column="1" IsEditable="True" Height="32" VerticalContentAlignment="Center"/>
                <TextBlock Text="目标仓库远程" Grid.Column="2" VerticalAlignment="Center"/>
                <ComboBox x:Name="InternalBox" Grid.Column="3" IsEditable="True" Height="32" VerticalContentAlignment="Center"/>
            </Grid>
        </DockPanel>

        <TextBlock Text="项目名称（可选，默认用目录名）" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" Height="34" IsCancel="True" Style="{StaticResource BaseButton}"/>
            <Button Content="添加" Width="90" Height="34" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

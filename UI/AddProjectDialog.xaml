<Window x:Class="VendorSync.UI.AddProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VendorSync.UI"
        Title="{loc:LocExt Title.AddProject}" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="20,16">
        <TextBlock Text="{loc:LocExt Add.Intro}"
                   TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,14"/>

        <DockPanel Margin="0,0,0,12">
            <Button Content="{loc:LocExt Btn.CloneNew}" Width="110" Height="32" DockPanel.Dock="Right" Margin="8,0,0,0"
                    Style="{StaticResource BaseButton}" Click="BtnClone_Click"/>
            <Button Content="{loc:LocExt Btn.Browse}" Width="80" Height="32" DockPanel.Dock="Right" Margin="8,0,0,0"
                    Style="{StaticResource BaseButton}" Click="BtnBrowse_Click"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:LocExt Add.PathLabel}" VerticalAlignment="Center"/>
                <TextBox x:Name="PathBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
            </Grid>
        </DockPanel>

        <DockPanel Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:LocExt Add.VendorLabel}" VerticalAlignment="Center"/>
                <ComboBox x:Name="VendorBox" Grid.Column="1" IsEditable="True" Height="32" VerticalContentAlignment="Center"/>
                <TextBlock Text="{loc:LocExt Add.InternalLabel}" Grid.Column="2" VerticalAlignment="Center"/>
                <ComboBox x:Name="InternalBox" Grid.Column="3" IsEditable="True" Height="32" VerticalContentAlignment="Center"/>
            </Grid>
        </DockPanel>

        <TextBlock Text="{loc:LocExt Add.NameLabel}" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:LocExt Btn.Cancel}" Width="90" Height="34" IsCancel="True" Style="{StaticResource BaseButton}"/>
            <Button Content="{loc:LocExt Btn.AddConfirm}" Width="90" Height="34" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
